module(
    name = "gazelle_rust_staticlib_conflict_repro",
    version = "0.0.0",
    bazel_compatibility = [">=8.5.0"],
)

bazel_dep(name = "gazelle", version = "0.50.0")
bazel_dep(name = "gazelle_py", version = "0.8.3")
bazel_dep(name = "gazelle_ts", version = "0.4.5")
bazel_dep(name = "llvm", version = "0.7.6")
bazel_dep(name = "rules_rs", version = "0.0.68")

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
rules_rust.patch(
    patches = ["//third_party/rules_rust/patches:crate_group_cc_info.patch"],
    strip = 1,
)
use_repo(rules_rust, "rules_rust")

# Prove the rlib-based fix against upstream sources before it is released:
# both language modules have namespaced C ABI symbols, and local patches switch
# their Go cdeps from the rolled-up staticlib to the Rust rlib.
git_override(
    module_name = "gazelle_py",
    commit = "5b4e319987732ce1ee39a51ed3ca0e8973cc4f1f",
    patch_strip = 1,
    patches = ["//third_party/gazelle_py/patches:use-rlib-cdeps.patch"],
    remote = "https://github.com/perplexityai/gazelle_py.git",
)

git_override(
    module_name = "gazelle_ts",
    commit = "e8d2ad517360081a96eeda79af24eb3e0e69a825",
    patch_strip = 1,
    patches = ["//third_party/gazelle_ts/patches:use-rlib-cdeps.patch"],
    remote = "https://github.com/hermeticbuild/gazelle_ts.git",
)
