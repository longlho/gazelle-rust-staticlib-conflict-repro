module(
    name = "gazelle_rust_staticlib_conflict_repro",
    version = "0.0.0",
    bazel_compatibility = [">=8.5.0"],
)

bazel_dep(name = "gazelle", version = "0.50.0")
bazel_dep(name = "gazelle_py", version = "0.8.3")
bazel_dep(name = "gazelle_ts", version = "0.4.5")
bazel_dep(name = "llvm", version = "0.7.6")
bazel_dep(name = "rules_rs", version = "0.0.68")

# Prove the fix against the patched upstream sources before they are released:
# gazelle_py has the C ABI namespacing fix from perplexityai/gazelle_py#45,
# while gazelle_ts carries the rules_rust/LLVM staticlib localization series
# from hermeticbuild/gazelle_ts#57.
git_override(
    module_name = "gazelle_py",
    commit = "5b4e319987732ce1ee39a51ed3ca0e8973cc4f1f",
    remote = "https://github.com/perplexityai/gazelle_py.git",
)

git_override(
    module_name = "gazelle_ts",
    commit = "831e579995abee18729644875dc4543809ba3ff5",
    remote = "https://github.com/hermeticbuild/gazelle_ts.git",
)
